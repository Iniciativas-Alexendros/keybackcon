[Unit]
Description=Keyboard Backlight Controls — restaura tu color al iniciar sesión
After=default.target

[Service]
Type=oneshot
ExecStart=__KEYBACKCON_BIN__ restore
RemainAfterExit=yes
# Al iniciar sesión las ACL uaccess pueden no estar aplicadas todavía:
# reintenta en vez de quedarse sin restaurar el color.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
